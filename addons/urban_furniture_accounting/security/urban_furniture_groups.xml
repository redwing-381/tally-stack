<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Admin (Business Owner): create/modify/archive master data,
             record transactions, view reports. -->
        <record id="group_urban_admin" model="res.groups">
            <field name="name">Urban Furniture / Admin</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager')),
                                              (4, ref('sales_team.group_sale_manager')),
                                              (4, ref('purchase.group_purchase_manager')),
                                              (4, ref('base.group_partner_manager'))]"/>
        </record>

        <!-- Invoicing User (Accountant): create master data, record
             transactions, view reports - not full admin. -->
        <record id="group_urban_invoicing_user" model="res.groups">
            <field name="name">Urban Furniture / Invoicing User</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice')),
                                              (4, ref('sales_team.group_sale_salesman')),
                                              (4, ref('purchase.group_purchase_user')),
                                              (4, ref('base.group_partner_manager'))]"/>
        </record>

        <!-- Contact persona uses the standard portal group
             (base.group_portal) plus Odoo's default record rules on
             account.move/sale.order, which already scope a portal user
             to documents where they are the partner. Verify this holds
             with a live instance before adding a custom ir.rule. -->
    </data>
</odoo>
