<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ufa_budget_list" model="ir.ui.view">
        <field name="name">ufa.budget.list</field>
        <field name="model">ufa.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="analytic_account_id"/>
                <field name="responsible_user_id"/>
                <field name="planned_amount"/>
                <field name="actual_amount"/>
                <field name="variance"/>
            </list>
        </field>
    </record>

    <record id="view_ufa_budget_form" model="ir.ui.view">
        <field name="name">ufa.budget.form</field>
        <field name="model">ufa.budget</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="analytic_account_id"/>
                        <field name="responsible_user_id"/>
                    </group>
                    <group>
                        <field name="period_start"/>
                        <field name="period_end"/>
                        <field name="planned_amount"/>
                        <field name="actual_amount"/>
                        <field name="variance"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ufa_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">ufa.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ufa_budget_root"
              name="Urban Furniture"
              parent="account.menu_finance"
              sequence="90"
              groups="urban_furniture_accounting.group_urban_admin,urban_furniture_accounting.group_urban_invoicing_user"/>

    <menuitem id="menu_ufa_budget"
              name="Budgets"
              parent="menu_ufa_budget_root"
              action="action_ufa_budget"
              sequence="10"/>
</odoo>
