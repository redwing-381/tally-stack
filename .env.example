# Copy this file to .env (already gitignored) and fill in your real key.
# docker compose reads .env automatically for ${VAR} substitution in
# docker-compose.yml — nothing else needs to change.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Any OpenRouter-hosted model that supports tool calling. Cheap and
# reliable at it by default; swap freely.
OPENROUTER_MODEL=openai/gpt-4o-mini
